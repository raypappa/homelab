{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'abandonments:recommended',
    ':semanticCommits',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':separateMultipleMajorReleases',
    'docker:enableMajor',
    'customManagers:biomeVersions',
    'github>raypappa/homelab//.github/renovate/customVersioning.json5',
    'github>raypappa/homelab//.github/renovate/customManagers.json5',
    'github>raypappa/homelab//.github/renovate/semanticCommits.json5',
    'github>raypappa/homelab//.github/renovate/commitMessage.json5',
    'group:nodeJs',
    'group:jestPlusTSJest',
    'group:jestPlusTypes',
    'group:kubernetesMonorepo',
    'group:remark',
    'group:socketio',
    'group:pulumi',
    'group:linters',
    'group:aws-cdkMonorepo',
    'group:githubArtifactActions',
    'default:automergeStableNonMajor',
    'security:openssf-scorecard',
  ],
  minimumReleaseAge: '7d',
  'pre-commit': {
    enabled: true,
  },
  ansible: {
    enabled: true,
    managerFilePatterns: [
      '/(^|)tasks/[^/]+\\.ya?ml$/',
    ],
  },
  'ansible-galaxy': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)(galaxy|requirements)(\\.ansible)?\\.ya?ml$/',
    ],
  },
  argocd: {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      matchManagers: ['github-actions'],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      matchManagers: ['devcontainer'],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
  ],
  postUpdateOptions: [
    'pnpmDedupe',
  ],
  lockFileMaintenance: {
    enabled: true,
    recreateWhen: 'always',
    automerge: true,
    rebaseWhen: 'behind-base-branch',
    branchTopic: 'lock-file-maintenance',
    commitMessageAction: 'Lock file maintenance',
    schedule: [
      'before 4am on monday',
    ],
    groupName: null,
    prBodyDefinitions: {
      Change: 'All locks refreshed',
    },
  },
}
